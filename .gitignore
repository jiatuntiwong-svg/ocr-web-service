# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# scratch / generated test artifacts
*.tmp.js

# tesseract training data (large, auto-downloaded by test scripts)
*.traineddata

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext
/.open-next

# wrangler files
.wrangler
.dev.vars*


!.dev.vars.example

# Claude Code local settings (machine-specific permissions, do not share)
.claude/

# Generated by `copy-pdf-worker` npm script at build time — rebuild instead of vcs
public/pdf.worker.min.mjs

# Stray HTML mockups / design exports kept locally
DOCRoom Logo _Standalone_.html
design_handoff_docroom_redesign/

# Local fixtures with real customer-looking documents — never push to public repo
test_compare/
scripts/poc-doc-extraction/samples/
scripts/poc-excel-extraction/samples/
# test_fixtures: keep local by default, but allow OCR-2 regression sources
# (synthetic HTML + README — no PII) to be committed.
test_fixtures/*
!test_fixtures/regression/
test_fixtures/regression/generated/
# S2-1: category-scoped generated PDFs (regeneration is deterministic from committed HTML)
test_fixtures/regression/*/generated/
# S2-1: real (uncommitted) landscape fixture per OCR-6b PII decision — CASE.md is committed
test_fixtures/regression/landscape/landscape-sibling-labels/source.pdf
pm/reports/test-1-runs/
pm/reports/OCR-2-runs/
